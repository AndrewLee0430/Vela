# Vela Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AI / Core ────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── Auth (Clerk) ──────────────────────────────────────────────
CLERK_SECRET_KEY=your-clerk-secret-key-here
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/vela

# ── Networking / CORS ─────────────────────────────────────────
ALLOWED_ORIGINS=https://vela.an-tho.com

# ── Payments (Dodo Payments) ──────────────────────────────────
# Live API key from https://dashboard.dodopayments.com
DODO_API_KEY=your-dodo-api-key
# Webhook secret from Dodo dashboard (starts with whsec_)
DODO_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Error Monitoring (Sentry) ─────────────────────────────────
# Backend DSN — set as Fly secret (runtime)
SENTRY_DSN=https://your-key@oXXX.ingest.sentry.io/YYYY
# Frontend DSN — set in fly.toml [build.args] (baked at build time)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXX.ingest.sentry.io/YYYY

# ── Admin ─────────────────────────────────────────────────────
# Clerk user ID allowed to access /api/admin/costs
ADMIN_USER_ID=user_your-clerk-admin-user-id

# ── Data Sources (Optional) ───────────────────────────────────
FDA_API_KEY=your-fda-api-key-here
PUBMED_API_KEY=your-pubmed-api-key-here
NCBI_EMAIL=your-email@example.com

# ── Analytics (Optional) ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
