# Vela Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── AI / Core ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================================
# Model Provider Configuration (per PRD §2.1 v1.4 + ADR 005)
# ============================================================
# Phase 0 ship state: all defaults are OpenAI; Groq provider is
# framework-ready but not activated. Phase 1B will evaluate
# switching lightweight tasks to Groq Llama 3.1 8B.

# Generator (RAG primary path: Research)
GENERATOR_PROVIDER=openai
GENERATOR_MODEL=gpt-4.1
GENERATOR_FALLBACK_MODEL=gpt-4.1-mini

# Guard (indirect injection detection + medical intent classification)
GUARD_PROVIDER=openai
GUARD_MODEL=gpt-4.1-mini

# Reranker (citation reranking)
RERANKER_PROVIDER=openai
RERANKER_MODEL=gpt-4o-mini

# Lightweight (Retriever query rewrite/relevance/translation + Entity extractor)
LIGHTWEIGHT_PROVIDER=openai
LIGHTWEIGHT_MODEL=gpt-4.1-mini

# Research Judge (LLMJudge — Research quality evaluation)
RESEARCH_JUDGE_PROVIDER=openai
RESEARCH_JUDGE_MODEL=gpt-4.1-mini

# Explain Judge (ExplainJudge — Explain 7-dim acceptance, §2.7 baseline)
EXPLAIN_JUDGE_PROVIDER=openai
EXPLAIN_JUDGE_MODEL=gpt-4.1

# Vision (OCR — medical report image extraction)
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o

# Verify (drug interaction analysis user-facing answer)
VERIFY_PROVIDER=openai
VERIFY_MODEL=gpt-4.1-mini

# Embedder (vector store for RAG retrieval)
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# Groq API key (Phase 1B activation, required only when *_PROVIDER=groq)
# GROQ_API_KEY=gsk_your-groq-api-key

# ── Auth (Clerk) ──────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_your-clerk-secret-key
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-clerk-publishable-key

# ── Database (PostgreSQL / Neon) ──────────────────────────────
# Falls back to SQLite if unset: sqlite:///./data/medinotes.db
DATABASE_URL=postgresql://user:password@host:5432/vela

# ── Networking / CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins. Falls back to http://localhost:3000
ALLOWED_ORIGINS=https://vela.an-tho.com

# ── Payments (Dodo Payments) ──────────────────────────────────
# Live API key from https://dashboard.dodopayments.com
DODO_API_KEY=your-dodo-api-key
# Webhook secret (starts with whsec_) — MANDATORY for webhook verification
DODO_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Admin ─────────────────────────────────────────────────────
# Clerk user ID allowed to access /api/admin/costs
ADMIN_USER_ID=user_your-clerk-admin-user-id

# ── Error Monitoring (Sentry) ─────────────────────────────────
# Backend DSN — set as Fly secret at runtime
SENTRY_DSN=https://your-key@oXXX.ingest.sentry.io/YYYY
# Frontend DSN — set in fly.toml [build.args] (baked at build time)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXX.ingest.sentry.io/YYYY

# ── Analytics (PostHog) ──────────────────────────────────────
# Set in fly.toml [build.args] for production (build-time)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Frontend API URL ─────────────────────────────────────────
# Set in fly.toml [build.args] for production (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Public Query Page (PRD § 4.5 Share Answer) ───────────────
# Public origin for share URLs and OG image absolute URLs.
VELA_PUBLIC_BASE_URL=https://vela.an-tho.com
# REQUIRED. Salt for sha256(salt + user_id)[:16] → SharedQuery.created_by.
# MUST be set in production (server fails to start otherwise). Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SHARE_CREATED_BY_SALT=replace-me-with-random-32-byte-token

# ── Data Sources (Optional) ──────────────────────────────────
# Increases rate limits for FDA and PubMed APIs
FDA_API_KEY=your-fda-api-key
PUBMED_API_KEY=your-pubmed-api-key
NCBI_EMAIL=your-email@example.com

# ── Legacy Payments (LemonSqueezy — deprecated) ──────────────
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_SIGNING_SECRET=

# ── Development Only ─────────────────────────────────────────
# Bypass Clerk JWT validation (blocked when FLY_APP_NAME is set)
# TEST_MODE=true
# Mock user ID when TEST_MODE is active
# TEST_USER_ID=test_user
