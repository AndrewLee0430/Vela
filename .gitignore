static/og/

# ==========================================
# TFDA brand→ingredient grounding (ADR 007 T2a) — COMMITTED data subtree
# ==========================================
# Override the blanket `data/` ignore (line ~135) for THIS subtree ONLY:
# the pinned TFDA id=37 snapshot + the generated deterministic lookup table are
# source-controlled for reproducibility (rebuild via scripts/build_tfda_brand_ingredient.py).
# Negation must come AFTER `data/` and re-include the directory before its contents.
!data/tfda/
!data/tfda/**
# DailyMed US-label corpus (Research 5th-source, Stage A) — pinned snapshot,
# rebuild via scripts/build_dailymed_label_corpus.py (float16 .npy keeps it ~3MB).
!data/dailymed/
!data/dailymed/**