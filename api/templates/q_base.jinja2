<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, follow">
<title>{{ og_title }}</title>
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
<meta name="twitter:image" content="{{ og_image }}">
{% block jsonld %}{% endblock %}
<style>
:root {
  --fg: #111827;
  --muted: #6b7280;
  --bg: #ffffff;
  --accent: #2563eb;
  --border: #e5e7eb;
  --card: #f9fafb;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", "Noto Sans CJK TC", sans-serif; color: var(--fg); background: var(--bg); line-height: 1.6; }
header { border-bottom: 1px solid var(--border); padding: 16px 24px; }
header a { color: var(--fg); text-decoration: none; font-weight: 600; font-size: 18px; }
main { max-width: 760px; margin: 32px auto; padding: 0 24px; }
.query { font-size: 22px; font-weight: 600; margin: 0 0 24px; }
.answer { font-size: 16px; white-space: pre-wrap; }
.citations { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
.citations h3 { font-size: 14px; color: var(--muted); margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.05em; }
.citations ol { padding-left: 20px; margin: 0; }
.citations li { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
.citations a { color: var(--accent); }
.cta { margin-top: 48px; padding: 24px; background: var(--card); border-radius: 12px; text-align: center; }
.cta-title { font-size: 18px; font-weight: 600; margin: 0 0 12px; }
.cta-button { display: inline-block; padding: 10px 20px; background: var(--accent); color: white; text-decoration: none; border-radius: 8px; font-weight: 500; }
footer { max-width: 760px; margin: 48px auto 32px; padding: 24px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); }
footer a { color: var(--muted); margin-right: 16px; }
.notice { padding: 32px; background: var(--card); border-radius: 12px; text-align: center; font-size: 16px; color: var(--muted); }
</style>
</head>
<body>
<header><a href="/">Vela</a></header>
<main>
{% block content %}{% endblock %}
</main>
<footer>
<p>{{ s.publicDisclaimer }}</p>
<p><a href="/privacy">{{ s.privacyLink }}</a><a href="/terms">{{ s.termsLink }}</a></p>
</footer>
</body>
</html>
