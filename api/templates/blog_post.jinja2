{% extends "explore_base.jinja2" %}

{# Vela Blog single-post template (PHASE A).
   Emits BOTH BlogPosting AND FAQPage JSON-LD per GEO best practice
   (two separate <script> tags; schema.org allows multiple on one page). #}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | tojson }},
  "description": {{ summary | tojson }},
  {% if published_at_iso %}"datePublished": {{ published_at_iso | tojson }},
  {% endif %}{% if updated_at_iso %}"dateModified": {{ updated_at_iso | tojson }},
  {% endif %}"author": {
    "@type": "Organization",
    "name": "Vela"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Vela"
  }{% if cover_image_url %},
  "image": {{ cover_image_url | tojson }}{% endif %},
  "url": {{ canonical_url | tojson }}
}
</script>
{% if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.q | tojson }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | tojson }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}

{% block content %}
<article class="vela-blog-post">
  <header class="vela-blog-header">
    <div class="vela-blog-theme-badge" style="background: {{ theme_color }};">{{ theme }}</div>
    <h1 class="vela-query-title">{{ title }}</h1>
    {% if published_at_iso %}
    <p class="vela-blog-meta">
      <time datetime="{{ published_at_iso }}">{{ published_at_iso[:10] }}</time>
    </p>
    {% endif %}
  </header>

  {% if summary %}
  <p class="vela-blog-summary">{{ summary }}</p>
  {% endif %}

  <div class="vela-prose vela-blog-body">{{ body_html }}</div>

  {% if faqs %}
  <section class="vela-blog-faq">
    <h2>FAQ</h2>
    {% for faq in faqs %}
    <div class="vela-blog-faq-item">
      <h3 class="vela-blog-faq-q">{{ faq.q }}</h3>
      <p class="vela-blog-faq-a">{{ faq.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if tags %}
  <footer class="vela-blog-tags">
    {% for tag in tags %}
    <span class="vela-blog-tag">{{ tag }}</span>
    {% endfor %}
  </footer>
  {% endif %}
</article>

<style>
.vela-blog-post { margin: 16px 0; }
.vela-blog-header { margin-bottom: 16px; }
.vela-blog-theme-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #0a1628;
  margin-bottom: 12px;
}
.vela-blog-meta {
  font-size: 0.85rem;
  color: var(--vela-text-muted);
  margin: 8px 0 0;
}
.vela-blog-summary {
  font-size: 1.05rem;
  color: var(--vela-text-body);
  line-height: 1.6;
  margin: 16px 0 24px;
  font-weight: 500;
}
.vela-blog-body { margin: 24px 0; }
.vela-blog-faq {
  margin: 32px 0;
  padding-top: 24px;
  border-top: 1px solid var(--vela-card-border);
}
.vela-blog-faq h2 {
  font-size: 1.25rem;
  color: var(--vela-text-primary);
  margin: 0 0 16px;
}
.vela-blog-faq-item {
  margin-bottom: 20px;
  padding: 16px;
  background: var(--vela-card-bg);
  border: 1px solid var(--vela-card-border);
  border-radius: 8px;
}
.vela-blog-faq-q {
  font-size: 1rem;
  color: var(--vela-text-primary);
  font-weight: 600;
  margin: 0 0 8px;
}
.vela-blog-faq-a {
  font-size: 0.95rem;
  color: var(--vela-text-body);
  line-height: 1.6;
  margin: 0;
}
.vela-blog-tags {
  margin-top: 24px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.vela-blog-tag {
  font-size: 0.75rem;
  padding: 2px 10px;
  background: rgba(255,255,255,0.08);
  color: var(--vela-text-muted);
  border-radius: 9999px;
}
</style>
{% endblock %}
