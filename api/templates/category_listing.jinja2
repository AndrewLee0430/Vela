{% extends "explore_base.jinja2" %}

{% block content %}
<nav class="vela-breadcrumb" aria-label="Breadcrumb">
  <a href="/">{{ s.breadcrumb_home }}</a>
  <span class="vela-breadcrumb-sep">›</span>
  <a href="/explore">{{ s.breadcrumb_explore }}</a>
  <span class="vela-breadcrumb-sep">›</span>
  <span class="vela-breadcrumb-current">{{ category }}</span>
</nav>

<h1 class="vela-query-title">{{ category_title }}</h1>

{% if pages %}
<div class="vela-category-list">
  {% for p in pages %}
  <a class="vela-category-card" href="/explore/{{ p.slug }}?locale={{ p.locale }}">
    <h3>{{ p.query_text }}</h3>
    {% if p.meta_description %}<p>{{ p.meta_description }}</p>{% endif %}
    {% if p.last_updated_at %}<span class="vela-category-card-meta">{{ p.last_updated_at }}</span>{% endif %}
  </a>
  {% endfor %}
</div>
{% else %}
<p class="vela-category-empty">{{ s.category_listing_empty }}</p>
{% endif %}
{% endblock %}
